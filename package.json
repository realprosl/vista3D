{
  "name": "vista3d",
  "version": "0.1.0",
  "description": "Sube un SVG, obtén una vista 3D compartible",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch & node --watch dist/server.js",
    "sample": "tsc scripts/make-sample-svg.ts --outDir dist-scripts && node dist-scripts/make-sample-svg.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3"
  }
}
